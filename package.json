{
  "name": "travel-tabletop",
  "version": "0.1.0",
  "description": "Offline, rules-free Magic: The Gathering playmat PWA for one or two devices",
  "scripts": {
    "test": "vitest run",
    "typecheck": "node node_modules/typescript-7/bin/tsc --noEmit -p . && node node_modules/typescript-7/bin/tsc --noEmit -p tests",
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "fake-indexeddb": "^6.2.7",
    "fast-check": "^4.10.2",
    "globals": "^17.14.0",
    "typescript": "^6.0.3",
    "typescript-7": "npm:typescript@^7.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "private": true,
  "type": "module",
  "dependencies": {
    "fflate": "^0.8.3",
    "idb": "^8.0.4",
    "jsqr": "^1.4.0",
    "preact": "^10.29.8",
    "uqr": "^0.1.3"
  }
}
